{
  "uid": "gophprofile-overview",
  "title": "GophProfile — Service Overview",
  "tags": ["gophprofile", "red"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "job",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(service_uptime_seconds{job=~\"gophprofile-.*\"}, job)",
        "current": { "text": "All", "value": "$__all" },
        "includeAll": true,
        "multi": true,
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "RED — Rate, Errors, Duration",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Request rate",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "decimals": 2, "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] } },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_requests_total{job=~\"$job\"}[5m]))", "legendFormat": "rps" }
      ]
    },
    {
      "type": "stat",
      "title": "Error rate (5xx)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "decimals": 2, "min": 0, "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "orange", "value": 0.01 },
            { "color": "red", "value": 0.05 } ] } },
        "overrides": []
      },
      "targets": [
        { "refId": "A",
          "expr": "sum(rate(http_requests_total{job=~\"$job\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total{job=~\"$job\"}[5m])), 0.001)",
          "legendFormat": "error ratio" }
      ]
    },
    {
      "type": "stat",
      "title": "Latency p95",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "s", "decimals": 3, "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "orange", "value": 0.5 },
            { "color": "red", "value": 2 } ] } },
        "overrides": []
      },
      "targets": [
        { "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=~\"$job\"}[5m])) by (le))",
          "legendFormat": "p95" }
      ]
    },
    {
      "type": "stat",
      "title": "In flight",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(http_requests_in_flight{job=~\"$job\"})", "legendFormat": "in flight" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Requests per second by route",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "targets": [
        { "refId": "A",
          "expr": "sum by (route) (rate(http_requests_total{job=~\"$job\"}[5m]))",
          "legendFormat": "{{route}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Responses by status",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" }, "showPoints": "never" } }, "overrides": [] },
      "targets": [
        { "refId": "A",
          "expr": "sum by (status) (rate(http_requests_total{job=~\"$job\"}[5m]))",
          "legendFormat": "{{status}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency percentiles",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 0, "showPoints": "never" } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{job=~\"$job\"}[5m])) by (le))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=~\"$job\"}[5m])) by (le))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{job=~\"$job\"}[5m])) by (le))", "legendFormat": "p99" }
      ]
    },
    {
      "type": "row",
      "title": "Business KPIs",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 }
    },
    {
      "type": "stat",
      "title": "Avatars stored",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 23 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(max by (processing_status) (avatars_total))", "legendFormat": "avatars" }
      ]
    },
    {
      "type": "stat",
      "title": "Storage used",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 23 },
      "fieldConfig": { "defaults": { "unit": "bytes", "color": { "mode": "fixed", "fixedColor": "purple" } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "max(avatars_storage_bytes)", "legendFormat": "bytes" }
      ]
    },
    {
      "type": "stat",
      "title": "Uploads (5m)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 23 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "green" } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(increase(avatars_uploads_total{status=\"success\"}[5m]))", "legendFormat": "uploads" }
      ]
    },
    {
      "type": "stat",
      "title": "Upload error ratio",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 23 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "decimals": 2, "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "orange", "value": 0.05 },
            { "color": "red", "value": 0.1 } ] } },
        "overrides": []
      },
      "targets": [
        { "refId": "A",
          "expr": "sum(rate(avatars_uploads_total{status=\"error\"}[5m])) / clamp_min(sum(rate(avatars_uploads_total[5m])), 0.001)",
          "legendFormat": "error ratio" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Avatars by processing status",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" }, "showPoints": "never" } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "max by (processing_status) (avatars_total)", "legendFormat": "{{processing_status}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Upload duration p95 / storage growth",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 0, "showPoints": "never" } },
        "overrides": [ { "matcher": { "id": "byName", "options": "storage" },
          "properties": [ { "id": "unit", "value": "bytes" }, { "id": "custom.axisPlacement", "value": "right" } ] } ] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum(rate(avatars_upload_duration_seconds_bucket[5m])) by (le))", "legendFormat": "upload p95" },
        { "refId": "B", "expr": "max(avatars_storage_bytes)", "legendFormat": "storage" }
      ]
    },
    {
      "type": "row",
      "title": "Resources",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 36 }
    },
    {
      "type": "timeseries",
      "title": "DB connections",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 37 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (job) (db_sql_connection_open{job=~\"$job\"})", "legendFormat": "{{job}} open" },
        { "refId": "B", "expr": "sum by (job) (db_sql_connection_open{job=~\"$job\", status=\"idle\"})", "legendFormat": "{{job}} idle" },
        { "refId": "C", "expr": "sum by (job) (db_sql_connection_open{job=~\"$job\", status=\"inuse\"})", "legendFormat": "{{job}} in use" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Goroutines",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 37 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "go_goroutine_count{job=~\"$job\"}", "legendFormat": "{{job}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory in use",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 37 },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (job) (go_memory_used{job=~\"$job\"})", "legendFormat": "{{job}}" }
      ]
    },
    {
      "type": "row",
      "title": "Logs",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 45 }
    },
    {
      "type": "logs",
      "title": "Errors (переход в трейс по полю trace_id)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 46 },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" },
      "targets": [
        { "refId": "A", "expr": "{job=~\"gophprofile-.*\"} | detected_level=\"error\"" }
      ]
    }
  ]
}
